{
  "underlying_asset": "all",
  "country": ["all"],
  "train_data_filename": "clean_train_history_context.csv",
  "test_data_filename": "clean_test_history_context.csv",
  "train_num_steps": 16000,
  "train_batch_size": 32,
  "train_lr": 0.00001,
  "warmup_ratio": 0.15,
