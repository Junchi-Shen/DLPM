  "financial_return_clip": 1.25,
  "sample_x0_clip": 1.35,
  "financial_loss_weights": {
    "pointwise_x0": 2.5,
    "return_range": 5.0,
    "terminal_drift": 0.7,
    "cumulative_return": 0.7,
    "global_vol": 3.0,
    "mean_abs_return": 5.0,
    "vol_clustering": 0.5,
    "volatility_clustering_acf": 0.35,
    "return_autocorr_1": 0.2,
    "return_autocorr_5": 0.1,
    "leverage_effect": 0.1,
    "tail_quantile": 0.1,
    "abs_tail_quantile": 4.5,
    "tail_iqr_ratio": 0.05,
    "tail_exceedance_0.5": 1.0,
    "tail_exceedance_1": 0.6,
    "tail_exceedance_2": 0.2,
    "drawdown": 0.35,
    "path_log_quantile": 0.5,
    "path_abs_quantile": 0.75,
    "path_terminal_quantile": 0.9,
    "path_drift": 0.35
