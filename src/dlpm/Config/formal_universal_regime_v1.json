  },
  "regime_balance": {
    "enabled": true,
    "use_asset_bucket": false,
    "asset_column": "asset_underlying",
    "normalize_features_within_group": true,
    "percentile_group_column": "asset_underlying",
    "balance_group_column": "asset_underlying",
    "vol_column": "hist_rv_60",
    "trend_column": "hist_trend_60",
    "drawdown_column": "hist_max_drawdown_60",
    "drawdown_stress_quantile": 0.25,
    "inverse_frequency_power": 0.4,
    "hierarchical_shrinkage_strength": 250.0,
    "weight_floor": 0.67,
    "weight_cap": 1.5
